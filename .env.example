# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Postgres connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weather_etl

# Alternative: set a full connection string directly instead of the
# individual POSTGRES_* vars above. If set, this takes priority.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Optional: only needed if you swap Open-Meteo for a provider that
# requires a key (e.g. OpenWeatherMap) ---
# WEATHER_API_KEY=your_api_key_here
